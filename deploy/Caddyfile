{
	# CA do Let's Encrypt. Para testar sem gastar o limite de emissões, use o staging
	# no .env: ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
	acme_ca {$ACME_CA}
}

# HTTPS automático (Let's Encrypt) para o sistema todo, num domínio só:
#   https://<DOMAIN>/api/...   -> Django (web:8000)  - API, documentação (/api/docs/)
#   https://<DOMAIN>/admin/... -> Django
#   https://<DOMAIN>/...       -> frontend React
# O certificado é emitido e renovado sozinho; precisa do DNS do domínio apontando
# para este servidor e das portas 80 e 443 abertas. Ver DEPLOY.md.
{$DOMAIN} {
	encode zstd gzip

	@django path /api/* /admin/* /static/* /django-rq/*
	handle @django {
		reverse_proxy web:8000
	}

	handle {
		reverse_proxy frontend:80
	}

	header {
		# Começa curto (HSTS_MAX_AGE=300) porque o navegador guarda e não dá para desfazer;
		# depois de validar, suba para 31536000 no .env.
		Strict-Transport-Security "max-age={$HSTS_MAX_AGE}"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# JSON: é o formato que o CrowdSec lê (deploy/seguranca/). Ver com: docker compose logs proxy
	log {
		output stdout
		format json
	}
}
