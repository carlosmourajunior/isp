# ==================== DJANGO SETTINGS ====================
SECRET_KEY=change-this-secret-key-in-production-make-it-very-long-and-random
DEBUG=True
ALLOWED_HOSTS=*

# Origem(ns) do frontend React (separadas por vírgula) - usado pelo CORS
FRONTEND_URL=http://localhost:3000

# URL da API que fica embutida no build do frontend (docker-compose build arg)
VITE_API_URL=http://localhost:8000/api

# ==================== DATABASE SETTINGS ====================
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# ==================== REDIS SETTINGS ====================
# REDIS_PASSWORD é usado pelo redis-server (docker-compose.yml) - se preenchido,
# inclua a mesma senha na REDIS_URL abaixo (redis://:SENHA@redis:6379/0)
REDIS_PASSWORD=change-this-redis-password
REDIS_URL=redis://:change-this-redis-password@redis:6379/0

# ==================== EMAIL SETTINGS ====================
# Configurar para receber alertas por email
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# ==================== SECURITY SETTINGS ====================
# Para produção, configurar adequadamente
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
X_FRAME_OPTIONS=DENY

# ==================== LOGGING SETTINGS ====================
LOG_LEVEL=INFO
LOG_MAX_SIZE_MB=10
LOG_BACKUP_COUNT=5

# ==================== OLT NOKIA (SSH / netmiko) ====================
# Lidas por olt/utils.py - build_nokia_connect_kwargs()
NOKIA_HOST=192.168.1.1
NOKIA_USERNAME=admin
NOKIA_PASSWORD=change-this-olt-password
NOKIA_DEVICE_TYPE=alcatel_aos
NOKIA_VERBOSE=False
NOKIA_GLOBAL_DELAY_FACTOR=2

# ==================== MÚLTIPLAS OLTs (model Olt) ====================
# Chave de criptografia das senhas de OLT salvas no banco. Gerar com:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NUNCA trocar depois de ter OLTs cadastradas sem re-cadastrar as senhas -
# invalida tudo que já foi criptografado com a chave anterior.
OLT_CREDENTIALS_KEY=change-this-generate-a-real-fernet-key

# ==================== IXC ERP (REST) ====================
# Lidas por olt/client_utils.py - search_ixc_page()
IXC_HOST=seu-ixc.exemplo.com.br
IXC_TOKEN=change-this-ixc-token

# ==================== API SETTINGS ====================
# JWT Token settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# API Rate limiting
API_RATE_LIMIT=1000/hour

# Token de acesso ao painel admin do RQ (django-rq) - defina um valor forte em produção
RQ_API_TOKEN=change-this-rq-admin-token

# ==================== BACKUP SETTINGS ====================
# Configurações de backup automático
BACKUP_ENABLED=True
BACKUP_RETENTION_DAYS=30

# ==================== DEVELOPMENT SETTINGS ====================
# Configurações apenas para desenvolvimento
DJANGO_EXTENSIONS_ENABLED=True
DEBUG_TOOLBAR_ENABLED=False

# ==================== SYSLOG DAS OLTs (ocupação de CTO) ====================
# Porta UDP publicada no host para o serviço syslog_collector.
SYSLOG_PORT=5140
# IPs de origem aceitos (vírgula). Vazio = aceita tudo (só para teste).
SYSLOG_ALLOWED_IPS=
# Hostname do cabeçalho do syslog -> OLT (preferencial; funciona com várias OLTs atrás do mesmo NAT).
# Formato: VIA01_OURO_FINO=OLT 1;VIA01_BORDA=OLT 2
SYSLOG_OLT_BY_HOSTNAME=
# IP de origem -> OLT, quando a OLT chega por NAT com IP diferente do Olt.host.
# Formato: 170.78.160.48=OLT Borda da Mata;1.2.3.4=OLT Ouro Fino
SYSLOG_OLT_BY_IP=
# OLT usada quando o IP de origem não bate com nenhum Olt.host (NAT/Docker
# Desktop trocam o IP de origem). Nome exato do cadastro de OLT.
SYSLOG_DEFAULT_OLT=
